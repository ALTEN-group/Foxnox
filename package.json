  },
  "homepage": "https://github.com/ALTEN-group/Foxnox#readme",
  "dependencies": {
    "@dwtechs/antity-pgsql": "0.23.0",
    "@dwtechs/checkard": "3.7.0",
    "@dwtechs/errandler-express": "0.1.1",
    "@dwtechs/gatelin-express": "0.3.0",
    "@dwtechs/hashitaka": "0.5.0",
    "@dwtechs/healix-express": "0.2.0",
    "@dwtechs/passken": "0.6.2",
