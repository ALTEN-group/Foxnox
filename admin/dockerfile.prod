ARG NODE_VERSION
ARG CADDY_VERSION

# Build stage runs on the native builder platform; Angular output is arch-independent.
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION} AS build

# Optional internal Alpine mirror (secret is optional; CI uses default Alpine mirrors).
RUN --mount=type=secret,id=apk_repository,target=/etc/apk/repositories \
    apk update && apk add --no-cache tzdata

ARG TZ
ENV TZ=${TZ}

ARG UID
ARG GID
RUN deluser --remove-home node \
    && addgroup -S usergroup -g ${GID} \
    && adduser -G usergroup -S user -u ${UID} \
    && mkdir -p /usr/src/app \
    && chown user:usergroup /usr/src/app

WORKDIR /usr/src/app
USER user

# Copy manifests first so dependency install is cached across source changes.
COPY --chown=user:usergroup package.json package-lock.json ./
RUN npm i --no-progress --no-fund --loglevel=error --ignore-scripts

COPY --chown=user:usergroup . .
RUN npm run build:prod

############
### prod ###
############
# Caddy on Alpine, run as non-root behind Traefik. Non-root cannot bind <1024,
# so ADMIN_PORT must stay above that; Traefik targets the same value.
FROM caddy:${CADDY_VERSION}-alpine

ARG UID
ARG GID
ARG ADMIN_PORT=8080
ENV ADMIN_PORT=${ADMIN_PORT}
RUN mkdir -p /data/caddy /config/caddy \
    && chown -R ${UID}:${GID} /data /config /usr/share/caddy

COPY --chown=${UID}:${GID} Caddyfile /etc/caddy/Caddyfile
COPY --from=build --chown=${UID}:${GID} /usr/src/app/dist/ /usr/share/caddy/foxnox/

USER ${UID}:${GID}
EXPOSE ${ADMIN_PORT}
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:${ADMIN_PORT}/healthz >/dev/null 2>&1 || exit 1
