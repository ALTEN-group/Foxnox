ARG NODE_VERSION=24.15.0-alpine3.22
FROM node:${NODE_VERSION}

# Use an internal Alpine mirror when supplied; otherwise keep the image defaults.
# Compose materialises an unset APK_REPOSITORY as an empty secret, so mounting it
# straight onto /etc/apk/repositories would wipe the public repos: copy it instead,
# and only when it carries content.
RUN --mount=type=secret,id=apk_repository,target=/tmp/apk_repository \
    if [ -s /tmp/apk_repository ]; then cp /tmp/apk_repository /etc/apk/repositories; fi \
    && apk update && apk add --no-cache tzdata

ARG TZ
ENV TZ=${TZ}
# RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Create a new simple user 
ARG UID
ARG GID
RUN deluser --remove-home node && addgroup -S usergroup -g ${GID} && adduser -G usergroup -S user -u ${UID}
USER user

ARG NPMRC_PATH=/home/user/.npmrc

WORKDIR /usr/src/app
COPY --chown=user:usergroup --chmod=640 package*.json ./

# Use a private npm registry when supplied; public npm works without the secret.
RUN --mount=type=secret,id=npmrc,target=${NPMRC_PATH},uid=${UID} \
    npm i --loglevel=error --ignore-scripts --no-fund

ENV PATH=/usr/src/app/node_modules/.bin:$PATH

# Owned by root so the app user can read/execute but not modify it at runtime.
COPY --chown=root:root --chmod=755 scripts/entrypoint.sh /docker-entrypoint.sh

ENTRYPOINT [ "/docker-entrypoint.sh" ]
# CMD ["sleep","3600"]
