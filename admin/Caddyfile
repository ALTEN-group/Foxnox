# Global options — running behind Traefik; no HTTPS or admin API needed.
{
	admin off
	auto_https off
	persist_config off
}

:{$ADMIN_PORT:8080} {
	root * /usr/share/caddy
	encode zstd gzip

	# Container HEALTHCHECK endpoint
	handle /healthz {
		respond "ok" 200
	}

	# Angular SPA under /foxnox baseHref
	handle /foxnox/* {
		try_files {path} /foxnox/index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
