APP_NAME=foxnox
NODE_VERSION=24.15.0-alpine3.22
NODE_ENV=production
TZ=Europe/Paris
UID=1000
GID=1000
HOME_PATH=/home/user/

ENV_NAME=production
DEFAULT_PORT=3000
SERVER_SCHEME=https://
SERVER_URL=localhost
STACK_NAME=${APP_NAME}-${ENV_NAME}

# Must match Gatelin's proxy DNS: `${APP_NAME}-${service.name}-${ENV_NAME}`
FOXNOX_HOST=${APP_NAME}-foxnox-${ENV_NAME}

# Liquibase
LIQUIBASE_VERSION=4.28.0-alpine
LIQUIBASE_DB_USER=liquibase
LIQUIBASE_DB_PWD=
LIQUIBASE_LOG_LEVEL=INFO
LIQUIBASE_UPDATE=1
LIQUIBASE_SNAPSHOT=0
LIQUIBASE_COMMAND_CONTEXTS=v1,oauth
LIQUIBASE_ROLLBACK=0

# Postgres
POSTGRES_HOST=${APP_NAME}-postgres-${ENV_NAME}
POSTGRES_VERSION=postgres:16.2-alpine3.19
POSTGRES_PORT=5432
POSTGRES_ROOT_USER=root
POSTGRES_ROOT_PWD=
POSTGRES_DBS=liquibase,gatelin,foxnox

# Traefik
TRAEFIK_HOST=${APP_NAME}-traefik-${ENV_NAME}
TRAEFIK_VERSION=3.6.4
TRAEFIK_ACCESSLOG=true
TRAEFIK_API_INSECURE=false
TRAEFIK_ENTRYPOINTS_WEB_ADDRESS=":80"
TRAEFIK_PROVIDERS_DOCKER_EXPOSEDBYDEFAULT=false
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_PING=true
TRAEFIK_PORT=8100
TRAEFIK_PREFIX=/api
TRAEFIK_PUBLIC_URL=${SERVER_SCHEME}${SERVER_URL}:${TRAEFIK_PORT}${TRAEFIK_PREFIX}/

# External user search endpoint used by Foxnox and Gatelin (required).
USER_SEARCH_URL=

# Gatelin (public /api gateway in front of Foxnox)
GATELIN_VERSION=0.1.0-alpha.8
GATELIN_HOST=${APP_NAME}-gatelin-${ENV_NAME}
GATELIN_DB_NAME=gatelin
GATELIN_DB_USER=
GATELIN_DB_PWD=
GATELIN_TOKEN_SECRET=
GATELIN_PWD_CHECK_URL=http://${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/compare
GATELIN_PWD_CHALLENGES_URL=http://${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/challenges
GATELIN_PWD_TRUSTED_DEVICES_URL=http://${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/devices/verify
GATELIN_PWD_LOGIN_TICKET_URL=http://${FOXNOX_HOST}:${DEFAULT_PORT}/foxnox/login-tickets/redeem
GATELIN_ACCESS_TOKEN_DURATION=600
GATELIN_REFRESH_TOKEN_DURATION=86400
GATELIN_REFRESH_TOKEN_COOKIE=true
GATELIN_REFRESH_TOKEN_COOKIE_HTTPS_ONLY=true
GATELIN_MIGRATION_SERVICE_NAME=gatelin-migration
GATELIN_MIGRATION_HOST=${APP_NAME}-${GATELIN_MIGRATION_SERVICE_NAME}-${ENV_NAME}

# Foxnox
FOXNOX_DB_NAME=foxnox
FOXNOX_DB_USER=
FOXNOX_DB_PWD=
FOXNOX_MIGRATION_SERVICE_NAME=${APP_NAME}-migration
FOXNOX_MIGRATION_HOST=${APP_NAME}-${FOXNOX_MIGRATION_SERVICE_NAME}-${ENV_NAME}
FOXNOX_ACCESS_TOKEN_DURATION=600
FOXNOX_REFRESH_TOKEN_DURATION=86400
FOXNOX_PWD_SECRET=

# Browser-facing workflow URLs (email deep links)
WEB_PUBLIC_BASE=/api/foxnox/web
WEB_PUBLIC_ORIGIN=${SERVER_SCHEME}${SERVER_URL}:${TRAEFIK_PORT}
# Admin login that redeems mid-login resume tickets (?ticket=…)
WEB_LOGIN_RESUME_URL=${SERVER_SCHEME}${SERVER_URL}:${TRAEFIK_PORT}/foxnox/login

# Workflow branding
WEB_BRAND_NAME=Foxnox
WEB_BRAND_TAGLINE="Account security"
WEB_BRAND_MARK=F
WEB_BRAND_PRIMARY_COLOR=#1f6feb
WEB_BRAND_PRIMARY_HOVER_COLOR=#1858c3
WEB_BRAND_SECONDARY_COLOR=#5c6570
WEB_BRAND_BACKGROUND_COLOR=#f4f6f8

# Outbound mail (real SMTP in production — do not point at Mailpit)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
# Quoted: scripts source this file, and bare <> would be shell redirections.
SMTP_FROM="Foxnox <noreply@example.com>"
# SMTP_USER=
# SMTP_PASS=

# Bundled admin UI (served by the Foxnox production image)
ADMIN_PORT=8080
ADMIN_BASE_PATH=/foxnox
# Optional. localStorage key for the access token (default: sso_access_token).
# Must match Gatelin admin's value since both share the same slot.
ADMIN_SSO_TOKEN_KEY=foxnox_sso_access_token

# Version (set by build-prod.sh or manually)
VERSION=
