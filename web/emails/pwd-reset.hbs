<p style="margin:0 0 16px;">{{greeting}}</p>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:700;">{{email.heading}}</h1>
<p style="margin:0 0 20px;color:#333;">{{email.intro}}</p>
<p style="margin:0 0 24px;">
  <a href="{{{url}}}" style="display:inline-block;padding:12px 20px;background:{{brand.primaryColor}};color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">{{email.cta}}</a>
</p>
<p style="margin:0 0 8px;font-size:13px;color:{{brand.secondaryColor}};">{{email.expiry}}</p>
<p style="margin:0;font-size:13px;color:{{brand.secondaryColor}};">{{email.ignore}}</p>
<p style="margin:16px 0 0;font-size:12px;word-break:break-all;color:{{brand.secondaryColor}};">
  <a href="{{{url}}}" style="color:{{brand.primaryColor}};">{{{url}}}</a>
</p>
