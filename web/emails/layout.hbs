<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{email.subject}}</title>
</head>
<body style="margin:0;padding:0;background:{{brand.backgroundColor}};color:#1a1a1a;font-family:Georgia,'Times New Roman',serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:{{brand.backgroundColor}};">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:8px;overflow:hidden;">
          <tr>
            <td style="padding:24px 28px 8px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;">
              <span style="display:inline-block;font-size:20px;font-weight:700;color:{{brand.primaryColor}};">{{brand.name}}</span>
              {{#if brand.tagline}}
              <div style="margin-top:4px;font-size:13px;color:{{brand.secondaryColor}};">{{brand.tagline}}</div>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td style="padding:8px 28px 28px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;font-size:16px;line-height:1.5;color:#1a1a1a;">
              {{{body}}}
            </td>
          </tr>
          {{#if brand.hasFooter}}
          <tr>
            <td style="padding:0 28px 24px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;font-size:12px;color:{{brand.secondaryColor}};">
              {{#if brand.footerUrl}}
              <a href="{{brand.footerUrl}}" style="color:{{brand.secondaryColor}};">{{brand.footerText}}</a>
              {{else}}
              {{brand.footerText}}
              {{/if}}
            </td>
          </tr>
          {{/if}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
