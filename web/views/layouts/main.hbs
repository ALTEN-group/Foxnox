<!DOCTYPE html>
<html lang="{{lang}}" dir="{{dir}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#f4f6f8">
  <title>{{page.title}}</title>
  <link rel="stylesheet" href="{{assetBase}}/assets/css/workflows.css">
</head>
<body>
  <a class="visually-hidden-focusable" href="#main">{{common.skipToContent}}</a>
  <header class="shell__header">
    <div class="shell__brand">
      <span class="shell__mark" aria-hidden="true">F</span>
      <span class="shell__name">{{site.name}}</span>
    </div>
    <p class="shell__tagline">{{site.tagline}}</p>
  </header>
  <main id="main" class="shell__main" tabindex="-1">
    {{{body}}}
  </main>
  <script src="{{assetBase}}/assets/js/workflows.js" defer></script>
</body>
</html>
