<section class="card">
  <h1 class="card__title">{{page.heading}}</h1>
  <p class="card__subtitle">{{page.subtitle}}</p>

  <form class="form" method="POST" action="{{urls.recoverRequest}}" novalidate>
    {{!--
      Honeypot decoy (same idea as the DW Technologies contact form).
      Real users never see it; bots that fill every field reveal themselves.
    --}}
    <div class="honeypot" aria-hidden="true">
      <label for="website">{{page.honeypotLabel}}</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
    </div>
    <input type="hidden" id="renderedAt" name="rendered_at" value="0">
    <input type="hidden" name="lang" value="{{lang}}">

    <div class="form-group">
      <label for="email">{{page.emailLabel}}</label>
      <input
        type="email"
        id="email"
        name="email"
        autocomplete="email"
        inputmode="email"
        required
        value="{{form.email}}"
      >
    </div>

    {{#if error}}
    <p class="form-error" role="alert" aria-live="assertive" aria-atomic="true">{{error}}</p>
    {{/if}}

    <button type="submit" class="btn btn--primary btn--block">{{page.submit}}</button>
  </form>
</section>
