<div class="form-group">
  <label for="password">{{page.passwordLabel}}</label>
  <div class="password-field">
    <input
      type="password"
      id="password"
      name="password"
      autocomplete="new-password"
      required
      minlength="{{policy.minLength}}"
      maxlength="{{policy.maxLength}}"
      data-min-length="{{policy.minLength}}"
    >
    <button type="button" class="password-toggle" data-password-toggle="password" aria-controls="password" aria-pressed="false" data-show-label="{{common.showPassword}}" data-hide-label="{{common.hidePassword}}" aria-label="{{common.showPassword}}" hidden>
      <svg class="password-toggle__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/><path class="password-toggle__slash" d="M3 3l18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</div>

<div class="form-group">
  <label for="confirm">{{page.confirmLabel}}</label>
  <div class="password-field">
    <input
      type="password"
      id="confirm"
      name="confirm"
      autocomplete="new-password"
      required
      minlength="{{policy.minLength}}"
      maxlength="{{policy.maxLength}}"
    >
    <button type="button" class="password-toggle" data-password-toggle="confirm" aria-controls="confirm" aria-pressed="false" data-show-label="{{common.showPassword}}" data-hide-label="{{common.hidePassword}}" aria-label="{{common.showPassword}}" hidden>
      <svg class="password-toggle__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/><path class="password-toggle__slash" d="M3 3l18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</div>

<div class="pwd-policy">
  <p class="pwd-policy__title" id="pwd-policy-title">{{common.policyTitle}}</p>
  <ul class="pwd-policy__list" aria-labelledby="pwd-policy-title">
    <li data-rule="length">{{format common.policyMinLength n=policy.minLength}}</li>
    {{#if policy.lowerCase}}<li data-rule="lower">{{common.policyLowerCase}}</li>{{/if}}
    {{#if policy.upperCase}}<li data-rule="upper">{{common.policyUpperCase}}</li>{{/if}}
    {{#if policy.number}}<li data-rule="number">{{common.policyNumber}}</li>{{/if}}
    {{#if policy.symbol}}<li data-rule="symbol">{{common.policySymbol}}</li>{{/if}}
  </ul>
</div>
