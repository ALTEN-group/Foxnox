                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/components/schemas/token" }
                  }
                }
              },
              "example": {
                "rows": [
                  { "userId": 1, "typeId": 1, "expiresAt": "2026-08-11T22:15:00Z" }
